{
    "$comment": "cctpl standard permissions fragment. Merge the 'permissions' object into the tpl repo's .claude/settings.json (keep its existing allow list). Replace <SEED_DIR> with the same directory as CCTPL_SEED_DIR in mise.toml. Spec: ../references/06-safety-rules.md",
    "permissions": {
        "additionalDirectories": [
            "<SEED_DIR>"
        ],
        "deny": [
            "Bash(git add *)",
            "Bash(git -C * add *)",
            "Bash(git commit *)",
            "Bash(git -C * commit *)",
            "Bash(git push *)",
            "Bash(git -C * push *)",
            "Bash(git merge *)",
            "Bash(git -C * merge *)",
            "Bash(git tag *)",
            "Bash(git -C * tag *)",
            "Bash(git checkout *)",
            "Bash(git -C * checkout *)",
            "Bash(git switch *)",
            "Bash(git -C * switch *)",
            "Bash(git reset *)",
            "Bash(git -C * reset *)",
            "Bash(git rebase *)",
            "Bash(git -C * rebase *)",
            "Bash(git stash *)",
            "Bash(git -C * stash *)",
            "Bash(git branch -d *)",
            "Bash(git -C * branch -d *)",
            "Bash(git branch -D *)",
            "Bash(git -C * branch -D *)",
            "Bash(git branch -m *)",
            "Bash(git -C * branch -m *)",
            "Bash(git branch -M *)",
            "Bash(git -C * branch -M *)",
            "Bash(git stash)",
            "Bash(git -C * stash)",
            "Bash(mise run publish*)",
            "Bash(mise r publish*)",
            "Bash(mise publish*)",
            "Bash(mise run release*)",
            "Bash(mise r release*)",
            "Bash(mise release*)",
            "Bash(mise run setup-*)",
            "Bash(mise r setup-*)",
            "Bash(mise setup-*)",
            "Bash(mise run update-github-metadata*)",
            "Bash(mise r update-github-metadata*)",
            "Bash(mise update-github-metadata*)",
            "Bash(mise run all*)",
            "Bash(mise r all*)",
            "Bash(mise all*)",
            "Bash(*publish_template.py*)",
            "Bash(uv publish*)",
            "Bash(*twine upload*)",
            "Bash(gh release create *)",
            "Bash(gh release edit *)",
            "Bash(gh release delete *)",
            "Bash(gh release upload *)",
            "Bash(gh repo edit *)",
            "Bash(gh api * -X *)",
            "Bash(gh api * --method *)"
        ]
    }
